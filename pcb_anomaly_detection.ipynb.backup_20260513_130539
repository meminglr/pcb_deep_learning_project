    "    trf_p_count = transfer_model.count_parameters()['trainable']\n",
    "    winner = \"CustomCNN\" if cnn_p_count < trf_p_count else \"TransferModel\"\n",
    "    print(f\"\\n→ F1 farkı < 0.05: Daha az parametreli model önerilir: {winner}\")\n",
