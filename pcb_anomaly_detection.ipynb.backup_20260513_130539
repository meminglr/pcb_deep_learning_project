    "# ── Bölüm 3.2: TransferModel Sınıfı (ResNet-18) ───────────────────────────\n",
    "class TransferModel(nn.Module):\n",
    "    \"\"\"\n",
    "    ResNet-18 tabanlı Transfer Learning modeli.\n",
    "    ImageNet ağırlıklarıyla önceden eğitilmiş omurga + yeni sınıflandırıcı başlık.\n",
    "    Giriş: (B, 3, 224, 224) → Çıkış: (B, 2) ham logit\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, backbone: str = \"resnet18\", dropout_rate: float = 0.5):\n",
    "        super(TransferModel, self).__init__()\n",
    "\n",
    "        # ResNet-18 omurgasını ImageNet ağırlıklarıyla yükle\n",
    "        self.backbone = models.resnet18(weights=ResNet18_Weights.IMAGENET1K_V1)\n",
    "\n",
    "        # Orijinal fc başlığını kaldır ve yeni başlıkla değiştir\n",
    "        in_features = self.backbone.fc.in_features  # 512\n",
    "        self.backbone.fc = nn.Sequential(\n",
    "            nn.Linear(in_features, 256),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.Dropout(p=dropout_rate),\n",
    "            nn.Linear(256, 2)   # 2 sınıf: Normal(0), Anomaly(1)\n",
    "        )\n",
    "\n",
    "    def freeze_backbone(self) -> None:\n",
    "        \"\"\"\n",
    "        conv1, bn1, relu, maxpool, layer1, layer2 katmanlarını dondurur.\n",
    "        layer3, layer4 ve yeni fc başlığı eğitilebilir kalır.\n",
    "        \"\"\"\n",
    "        # Tüm omurgayı önce dondur\n",
    "        for param in self.backbone.parameters():\n",
    "            param.requires_grad = False\n",
    "\n",
    "        # layer3, layer4 ve yeni fc başlığını eğitilebilir yap\n",
    "        for layer in [self.backbone.layer3,\n",
    "                      self.backbone.layer4,\n",
    "                      self.backbone.fc]:\n",
    "            for param in layer.parameters():\n",
    "                param.requires_grad = True\n",
    "\n",
    "    def forward(self, x: torch.Tensor) -> torch.Tensor:\n",
    "        \"\"\"Giriş: (B, 3, 224, 224) → Çıkış: (B, 2) ham logit\"\"\"\n",
    "        return self.backbone(x)  # Ham logit — softmax/sigmoid uygulanmaz\n",
    "\n",
    "    def count_parameters(self) -> Dict[str, int]:\n",
    "        \"\"\"Toplam ve eğitilebilir parametre sayısını döndürür.\"\"\"\n",
    "        total     = sum(p.numel() for p in self.parameters())\n",
    "        trainable = sum(p.numel() for p in self.parameters() if p.requires_grad)\n",
    "        return {\"total\": total, \"trainable\": trainable}\n",
    "\n",
    "\n",
    "# Model örneği oluştur, omurgayı dondur ve parametre sayısını raporla\n",
    "transfer_model = TransferModel(backbone=\"resnet18\", dropout_rate=0.5)\n",
