   "source": [
    "# ── Bölüm 2.3: DataLoader Fabrika Fonksiyonu ──────────────────────────────\n",
    "def create_dataloaders(\n",
    "    data_root: str,\n",
    "    batch_size: int = 32,\n",
    "    num_workers: int = 0,   # MPS uyumluluğu için 0\n",
    "    seed: int = 42\n",
    ") -> Tuple[DataLoader, DataLoader, DataLoader, Dict]:\n",
    "    \"\"\"\n",
    "    PCB veri setini yükler, %70/%15/%15 stratifiye böler ve\n",
    "    DataLoader'ları oluşturur.\n",
    "\n",
    "    Döndürür:\n",
    "        train_loader, val_loader, test_loader, class_weights_dict\n",
    "    \"\"\"\n",
    "    # Dosyaları keşfet\n",
    "    all_paths, all_labels = PCBDataset.discover_files(data_root)\n",
    "\n",
    "    # Stratifiye %70 / %30 bölme (eğitim vs. geçici)\n",
    "    train_paths, temp_paths, train_labels, temp_labels = train_test_split(\n",
    "        all_paths, all_labels,\n",
    "        test_size=0.30,\n",
    "        stratify=all_labels,\n",
    "        random_state=seed\n",
    "    )\n",
    "\n",
    "    # Geçici seti %50 / %50 böl → %15 val, %15 test\n",
    "    val_paths, test_paths, val_labels, test_labels = train_test_split(\n",
    "        temp_paths, temp_labels,\n",
    "        test_size=0.50,\n",
    "        stratify=temp_labels,\n",
    "        random_state=seed\n",
    "    )\n",
    "\n",
    "    # Sınıf ağırlıklarını YALNIZCA eğitim bölümünden hesapla\n",
    "    n_normal  = sum(1 for l in train_labels if l == 0)\n",
    "    n_anomaly = sum(1 for l in train_labels if l == 1)\n",
    "    class_weights = torch.tensor([1.0 / n_normal, 1.0 / n_anomaly],\n",
    "                                  dtype=torch.float32)\n",
    "\n",
    "    # WeightedRandomSampler için örnek ağırlıkları\n",
    "    sample_weights = [\n",
    "        1.0 / n_normal if label == 0 else 1.0 / n_anomaly\n",
    "        for label in train_labels\n",
    "    ]\n",
    "    sampler = WeightedRandomSampler(\n",
    "        weights=sample_weights,\n",
    "        num_samples=len(train_labels),\n",
    "        replacement=True\n",
    "    )\n",
    "\n",
    "    # Dataset örnekleri\n",
    "    train_dataset = PCBDataset(train_paths, train_labels, transform=train_transform)\n",
    "    val_dataset   = PCBDataset(val_paths,   val_labels,   transform=val_test_transform)\n",
    "    test_dataset  = PCBDataset(test_paths,  test_labels,  transform=val_test_transform)\n",
    "\n",
    "    # DataLoader'lar\n",
    "    train_loader = DataLoader(train_dataset, batch_size=batch_size,\n",
    "                              sampler=sampler, num_workers=num_workers)\n",
    "    val_loader   = DataLoader(val_dataset,   batch_size=batch_size,\n",
    "                              shuffle=False,  num_workers=num_workers)\n",
    "    test_loader  = DataLoader(test_dataset,  batch_size=batch_size,\n",
    "                              shuffle=False,  num_workers=num_workers)\n",
    "\n",
    "    # Sınıf dağılımını raporla\n",
    "    def _report(split_name, labels):\n",
    "        n = sum(1 for l in labels if l == 0)\n",
    "        a = sum(1 for l in labels if l == 1)\n",
    "        total = len(labels)\n",
    "        print(f\"  {split_name:12s}: Toplam={total:4d}  \"\n",
    "              f\"Normal={n:4d} ({100*n/total:.1f}%)  \"\n",
    "              f\"Anomaly={a:3d} ({100*a/total:.1f}%)\")\n",
    "\n",
    "    print(\"\\nVeri seti bölümleri:\")\n",
    "    _report(\"Eğitim\",     train_labels)\n",
    "    _report(\"Doğrulama\",  val_labels)\n",
    "    _report(\"Test\",       test_labels)\n",
    "\n",
    "    print(f\"\\nSınıf ağırlıkları (eğitim bölümünden):\")\n",
    "    print(f\"  Normal  ağırlığı : {class_weights[0]:.6f}\")\n",
    "    print(f\"  Anomaly ağırlığı : {class_weights[1]:.6f}\")\n",
    "\n",
    "    class_weights_dict = {\n",
    "        \"weights_tensor\": class_weights,\n",
    "        \"n_normal_train\": n_normal,\n",
    "        \"n_anomaly_train\": n_anomaly\n",
    "    }\n",
    "\n",
    "    return train_loader, val_loader, test_loader, class_weights_dict\n",
    "\n",
    "\n",
    "# DataLoader'ları oluştur\n",
    "train_loader, val_loader, test_loader, cw_dict = create_dataloaders(\n",
    "    DATA_ROOT, batch_size=32, num_workers=0, seed=42\n",
    ")\n",
    "class_weights = cw_dict[\"weights_tensor\"]\n",
    "\n",
    "print(f\"\\nDataLoader'lar hazır:\")\n",
    "print(f\"  Eğitim   batch sayısı : {len(train_loader)}\")\n",
    "print(f\"  Doğrulama batch sayısı: {len(val_loader)}\")\n",
    "print(f\"  Test     batch sayısı : {len(test_loader)}\")"
   ]
  },
