   "source": [
    "# ── Bölüm 2.2: Dönüşüm Pipeline'ları ─────────────────────────────────────\n",
    "# Eğitim için veri artırma (augmentation) dönüşümleri\n",
    "train_transform = transforms.Compose([\n",
    "    transforms.Resize((224, 224)),\n",
    "    transforms.RandomHorizontalFlip(p=0.5),\n",
    "    transforms.RandomRotation(degrees=15),\n",
    "    transforms.ColorJitter(brightness=0.1, contrast=0.1),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=[0.485, 0.456, 0.406],\n",
    "                         std=[0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "# Doğrulama ve test için yalnızca yeniden ölçeklendirme + normalizasyon\n",
    "val_test_transform = transforms.Compose([\n",
    "    transforms.Resize((224, 224)),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=[0.485, 0.456, 0.406],\n",
    "                         std=[0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "print(\"Dönüşüm pipeline'ları tanımlandı:\")\n",
    "print(\"  train_transform  : Resize + RandomHFlip + RandomRotation + ColorJitter + Normalize\")\n",
    "print(\"  val_test_transform: Resize + Normalize (augmentation yok)\")"
   ]
  },
