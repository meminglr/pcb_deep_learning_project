    "print(f\"  F1 farkı              : {f1_diff:.4f}\")\n",
    "\n",
    "if f1_diff >= 0.05:\n",
    "    winner = \"TransferModel\" if transfer_f1 > cnn_f1 else \"CustomCNN\"\n",
    "    print(f\"\\n→ F1 farkı >= 0.05: Daha yüksek F1'li model önerilir: {winner}\")\n",
    "    print(f\"  Gerekçe: {f1_diff:.4f} puanlık anlamlı performans farkı mevcuttur.\")\n",
