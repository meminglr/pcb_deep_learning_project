    "class Trainer:\n",
    "    \"\"\"\n",
    "    Model eğitim döngüsünü yöneten sınıf.\n",
    "    Early stopping, ReduceLROnPlateau ve en iyi model kaydetme içerir.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        model: nn.Module,\n",
    "        device: torch.device,\n",
    "        class_weights: torch.Tensor = None,\n",
    "        lr: float = 1e-3,\n",
    "        max_epochs: int = 50,\n",
    "        patience: int = 15\n",
    "    ):\n",
    "        self.model         = model\n",
    "        self.device        = device\n",
    "        self.max_epochs    = max_epochs\n",
    "        self.patience      = patience\n",
    "\n",
    "        # Optimizer: yalnızca eğitilebilir parametreler\n",
    "        self.optimizer = optim.Adam(\n",
    "            filter(lambda p: p.requires_grad, model.parameters()),\n",
    "            lr=lr\n",
    "        )\n",
    "\n",
    "        # LR Scheduler: doğrulama kaybı iyileşmezse LR'yi yarıya indir\n",
    "        # Not: Early stopping patience (self.patience) scheduler'dan büyük olmalıdır.\n",
    "        self.scheduler = optim.lr_scheduler.ReduceLROnPlateau(\n",
    "            self.optimizer, mode='min', factor=0.5, patience=5\n",
    "        )\n",
    "\n",
    "        # Ağırlıklı kayıp fonksiyonu\n",
    "        # Sampler kullanıldığında loss weight kullanmamak daha dengeli bir eğitim sağlar.\n",
    "        if class_weights is not None:\n",
    "            self.criterion = nn.CrossEntropyLoss(weight=class_weights.to(device))\n",
    "        else:\n",
    "            self.criterion = nn.CrossEntropyLoss()\n",
    "\n",
    "        # Eğitim süresi takibi\n",
    "        self.training_time_seconds = 0.0\n",
    "\n",
    "    def _train_epoch(self, loader: DataLoader) -> Tuple[float, float, float, float]:\n",
    "        \"\"\"Bir epoch eğitim yapar. (loss, accuracy) döndürür.\"\"\"\n",
    "        self.model.train()\n",
    "        total_loss, correct, total = 0.0, 0, 0\n",
    "        all_labels, all_preds = [], []\n",
    "\n",
    "        for images, labels in loader:\n",
    "            images = images.to(self.device)\n",
    "            labels = labels.to(self.device)\n",
    "\n",
    "            self.optimizer.zero_grad()\n",
    "            outputs = self.model(images)\n",
    "            loss    = self.criterion(outputs, labels)\n",
    "            loss.backward()\n",
    "            self.optimizer.step()\n",
    "\n",
    "            total_loss += loss.item() * images.size(0)\n",
    "            preds       = outputs.argmax(dim=1)\n",
    "            correct    += (preds == labels).sum().item()\n",
    "            total      += images.size(0)\n",
    "            all_preds.extend(preds.cpu().detach().numpy())\n",
    "            all_labels.extend(labels.cpu().numpy())\n",
    "\n",
    "        avg_loss = total_loss / total\n",
    "        accuracy = 100.0 * correct / total\n",
    "        from sklearn.metrics import recall_score\n",
    "        rec_0 = recall_score(all_labels, all_preds, pos_label=0, zero_division=0)\n",
    "        rec_1 = recall_score(all_labels, all_preds, pos_label=1, zero_division=0)\n",
    "        return avg_loss, accuracy, rec_0, rec_1\n",
    "\n",
    "    def _validate_epoch(self, loader: DataLoader) -> Tuple[float, float, float, float]:\n",
    "        \"\"\"Bir epoch doğrulama yapar. (loss, accuracy, recall_0, recall_1) döndürür.\"\"\"\n",
    "        self.model.eval()\n",
    "        total_loss, correct, total = 0.0, 0, 0\n",
    "        all_preds, all_labels = [], []\n",
    "\n",
    "        with torch.no_grad():\n",
    "            for images, labels in loader:\n",
    "                images = images.to(self.device)\n",
    "                labels = labels.to(self.device)\n",
    "\n",
    "                outputs    = self.model(images)\n",
    "                loss       = self.criterion(outputs, labels)\n",
    "                total_loss += loss.item() * images.size(0)\n",
    "                preds       = outputs.argmax(dim=1)\n",
    "                correct    += (preds == labels).sum().item()\n",
    "                total      += images.size(0)\n",
    "                \n",
    "                all_preds.extend(preds.cpu().numpy())\n",
    "                all_labels.extend(labels.cpu().numpy())\n",
    "\n",
    "        avg_loss = total_loss / total\n",
    "        accuracy = 100.0 * correct / total\n",
    "        \n",
    "        from sklearn.metrics import recall_score\n",
    "        r0 = recall_score(all_labels, all_preds, pos_label=0, zero_division=0)\n",
    "        r1 = recall_score(all_labels, all_preds, pos_label=1, zero_division=0)\n",
    "        \n",
    "        return avg_loss, accuracy, r0, r1\n",
    "\n",
    "    def _save_best(self, model_name: str) -> None:\n",
    "        \"\"\"En iyi model ağırlıklarını diske kaydeder.\"\"\"\n",
    "        torch.save(self.model.state_dict(), f\"best_{model_name}.pth\")\n",
    "\n",
    "    def train(\n",
    "        self,\n",
    "        train_loader: DataLoader,\n",
    "        val_loader: DataLoader,\n",
    "        model_name: str\n",
    "    ) -> Dict[str, List[float]]:\n",
    "        \"\"\"\n",
    "        Modeli eğitir. Eğitim geçmişini döndürür.\n",
    "        \"\"\"\n",
    "        history = {\n",
    "            \"train_loss\": [], \"val_loss\": [],\n",
    "            \"train_acc\":  [], \"val_acc\":  []\n",
    "        }\n",
    "\n",
    "        best_val_loss    = float('inf')\n",
    "        patience_counter = 0\n",
    "        start_time       = time.time()\n",
    "\n",
    "        print(f\"\\n{'='*60}\")\n",
    "        print(f\"Model eğitimi başlıyor: {model_name}\")\n",
    "        print(f\"Max epoch: {self.max_epochs} | Early stopping patience: {self.patience}\")\n",
    "        print(f\"{'='*60}\")\n",
    "        print(f\"{'Epoch':>6} | {'Train Loss':>10} | {'Val Loss':>10} | \"\n",
    "              f\"{'Train Acc':>10} | {'Val Acc (R0/R1)':>20}\")\n",
    "        print(f\"{'-'*60}\")\n",
    "\n",
    "        for epoch in range(1, self.max_epochs + 1):\n",
    "            train_loss, train_acc, tr0, tr1 = self._train_epoch(train_loader)\n",
    "            val_loss, val_acc, r0, r1 = self._validate_epoch(val_loader)\n",
    "\n",
    "            # Geçmişe kaydet\n",
    "            history[\"train_loss\"].append(train_loss)\n",
    "            history[\"val_loss\"].append(val_loss)\n",
    "            history[\"train_acc\"].append(train_acc)\n",
    "            history[\"val_acc\"].append(val_acc)\n",
    "\n",
    "            # LR Scheduler güncelle\n",
    "            self.scheduler.step(val_loss)\n",
    "\n",
    "            # Konsola yazdır\n",
    "            print(f\"{epoch:>6} | {train_loss:>10.4f} | {val_loss:>10.4f} | \"\n",
    "                  f\"{train_acc:>9.2f}% | {val_acc:>9.2f}% | R:{r0:.2f}/{r1:.2f}\")\n",
    "\n",
    "            # En iyi model kontrolü\n",
    "            if val_loss < best_val_loss:\n",
    "                best_val_loss    = val_loss\n",
    "                patience_counter = 0\n",
    "                self._save_best(model_name)\n",
    "            else:\n",
    "                patience_counter += 1\n",
    "                if patience_counter >= self.patience:\n",
    "                    print(f\"\\nErken durdurma tetiklendi: Epoch {epoch}\")\n",
    "                    break\n",
    "\n",
    "        # Eğitim süresini raporla\n",
    "        elapsed = time.time() - start_time\n",
    "        self.training_time_seconds = elapsed\n",
    "        mins, secs = divmod(int(elapsed), 60)\n",
    "        print(f\"\\nEğitim süresi: {mins} dakika {secs} saniye\")\n",
    "        print(f\"En iyi doğrulama kaybı: {best_val_loss:.4f}\")\n",
    "        print(f\"Model kaydedildi: best_{model_name}.pth\")\n",
    "\n",
    "        return history"
   ]
