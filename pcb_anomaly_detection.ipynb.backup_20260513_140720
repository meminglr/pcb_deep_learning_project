   "source": [
    "# ── Bölüm 4.4: HyperparamAnalyzer Sınıfı ─────────────────────────────────\n",
    "class HyperparamAnalyzer:\n",
    "    \"\"\"\n",
    "    Öğrenme oranı hiperparametre analizini yürüten sınıf.\n",
    "    Her LR değeri için bağımsız bir CNN eğitir ve val_f1_weighted kaydeder.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        train_loader: DataLoader,\n",
    "        val_loader: DataLoader,\n",
    "        class_weights: torch.Tensor,\n",
    "        device: torch.device\n",
    "    ):\n",
    "        self.train_loader  = train_loader\n",
    "        self.val_loader    = val_loader\n",
    "        self.class_weights = class_weights\n",
    "        self.device        = device\n",
    "\n",
    "    def run_lr_search(\n",
    "        self,\n",
    "        lr_values: List[float] = [1e-2, 1e-3, 1e-4],\n",
    "        max_epochs: int = 10,\n",
    "        patience: int = 3\n",
    "    ) -> pd.DataFrame:\n",
    "        \"\"\"\n",
    "        Her LR değeri için bağımsız bir CustomCNN eğitir.\n",
    "        Döndürür: DataFrame(columns=[learning_rate, val_f1_weighted])\n",
    "        \"\"\"\n",
    "        results = []\n",
    "\n",
    "        for lr in lr_values:\n",
    "            print(f\"\\n{'─'*50}\")\n",
    "            print(f\"LR Deneyi: lr={lr}\")\n",
    "            print(f\"{'─'*50}\")\n",
    "\n",
    "            # Tekrarlanabilirlik için seed ayarla\n",
    "            torch.manual_seed(42)\n",
    "            np.random.seed(42)\n",
    "\n",
    "            # Yeni model örneği\n",
    "            model = CustomCNN(dropout_rate=0.5).to(self.device)\n",
    "\n",
    "            # Trainer ile eğit\n",
    "            trainer = Trainer(\n",
    "                model=model,\n",
    "                device=self.device,\n",
    "                class_weights=None,\n",
    "                lr=lr,\n",
    "                max_epochs=max_epochs,\n",
    "                patience=patience\n",
    "            )\n",
    "            trainer.train(self.train_loader, self.val_loader,\n",
    "                          model_name=f\"lr_search_{lr}\")\n",
    "\n",
    "            # Doğrulama seti üzerinde val_f1_weighted hesapla\n",
    "            model.eval()\n",
    "            all_preds, all_labels_list = [], []\n",
    "            with torch.no_grad():\n",
    "                for images, labels in self.val_loader:\n",
    "                    images = images.to(self.device)\n",
    "                    outputs = model(images)\n",
    "                    preds   = outputs.argmax(dim=1).cpu().numpy()\n",
    "                    all_preds.extend(preds)\n",
    "                    all_labels_list.extend(labels.numpy())\n",
    "\n",
    "            val_f1 = f1_score(all_labels_list, all_preds,\n",
    "                              average='weighted', zero_division=0)\n",
    "            results.append({\"learning_rate\": lr, \"val_f1_weighted\": val_f1})\n",
    "            print(f\"  → val_f1_weighted = {val_f1:.4f}\")\n",
    "\n",
    "            # Geçici model dosyasını temizle\n",
    "            import os as _os\n",
    "            tmp_file = f\"best_lr_search_{lr}.pth\"\n",
    "            if _os.path.exists(tmp_file):\n",
    "                _os.remove(tmp_file)\n",
    "\n",
    "        df = pd.DataFrame(results)\n",
    "        best_row = df.loc[df[\"val_f1_weighted\"].idxmax()]\n",
    "        print(f\"\\nEn iyi öğrenme oranı: {best_row['learning_rate']}, \"\n",
    "              f\"Doğrulama F1: {best_row['val_f1_weighted']:.4f}\")\n",
    "        return df\n",
    "\n",
    "    def plot_lr_analysis(self, results: pd.DataFrame) -> None:\n",
    "        \"\"\"LR analiz sonuçlarını log-scale x ekseniyle görselleştirir.\"\"\"\n",
    "        fig, ax = plt.subplots(figsize=(8, 5))\n",
    "        ax.plot(results[\"learning_rate\"], results[\"val_f1_weighted\"],\n",
    "                marker='o', linewidth=2, markersize=8, color='steelblue')\n",
    "\n",
    "        for _, row in results.iterrows():\n",
    "            ax.annotate(f\"{row['val_f1_weighted']:.3f}\",\n",
    "                        (row['learning_rate'], row['val_f1_weighted']),\n",
    "                        textcoords=\"offset points\", xytext=(0, 10),\n",
    "                        ha='center', fontsize=10)\n",
    "\n",
    "        ax.set_xscale('log')\n",
    "        ax.set_xlabel('Öğrenme Oranı (log ölçeği)', fontsize=12)\n",
    "        ax.set_ylabel('Doğrulama Weighted-F1', fontsize=12)\n",
    "        ax.set_title('Öğrenme Oranı Analizi', fontsize=14, fontweight='bold')\n",
    "        ax.grid(True, alpha=0.3)\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "\n",
    "print(\"HyperparamAnalyzer sınıfı tanımlandı.\")"
   ]
