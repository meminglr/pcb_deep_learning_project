   "source": [
    "# ── Bölüm 2.1: PCBDataset Sınıfı ──────────────────────────────────────────\n",
    "class PCBDataset(Dataset):\n",
    "    \"\"\"\n",
    "    PCB görüntü veri seti için PyTorch Dataset sınıfı.\n",
    "    Normal dizini → etiket 0, Anomaly dizini → etiket 1\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, image_paths: List[str], labels: List[int],\n",
    "                 transform=None):\n",
    "        self.image_paths = image_paths\n",
    "        self.labels = labels\n",
    "        self.transform = transform\n",
    "\n",
    "    def __len__(self) -> int:\n",
    "        return len(self.image_paths)\n",
    "\n",
    "    def __getitem__(self, idx: int) -> Tuple[torch.Tensor, int]:\n",
    "        img_path = self.image_paths[idx]\n",
    "        label = self.labels[idx]\n",
    "        try:\n",
    "            image = Image.open(img_path).convert(\"RGB\")\n",
    "        except Exception as e:\n",
    "            print(f\"WARNING: {img_path} - {e}\")\n",
    "            # Bozuk görüntü yerine siyah görüntü döndür\n",
    "            image = Image.new(\"RGB\", (224, 224), color=0)\n",
    "        if self.transform:\n",
    "            image = self.transform(image)\n",
    "        return image, label\n",
    "\n",
    "    @staticmethod\n",
    "    def discover_files(data_root: str) -> Tuple[List[str], List[int]]:\n",
    "        \"\"\"\n",
    "        data_root/Normal/ ve data_root/Anomaly/ dizinlerindeki\n",
    "        tüm .JPG dosyalarını keşfeder ve etiketler.\n",
    "        Normal → 0, Anomaly → 1\n",
    "        \"\"\"\n",
    "        normal_dir = os.path.join(data_root, \"Normal\")\n",
    "        anomaly_dir = os.path.join(data_root, \"Anomaly\")\n",
    "\n",
    "        # Eksik dizin kontrolü\n",
    "        for d, name in [(normal_dir, \"Normal\"), (anomaly_dir, \"Anomaly\")]:\n",
    "            if not os.path.isdir(d):\n",
    "                raise FileNotFoundError(\n",
    "                    f\"Dizin bulunamadı: '{d}'. \"\n",
    "                    f\"Lütfen DATA_ROOT değişkenini kontrol edin.\"\n",
    "                )\n",
    "\n",
    "        image_paths: List[str] = []\n",
    "        labels: List[int] = []\n",
    "\n",
    "        # Normal görüntüler (etiket: 0)\n",
    "        for fname in sorted(os.listdir(normal_dir)):\n",
    "            if fname.upper().endswith(\".JPG\"):\n",
    "                image_paths.append(os.path.join(normal_dir, fname))\n",
    "                labels.append(0)\n",
    "\n",
    "        # Anomaly görüntüler (etiket: 1)\n",
    "        for fname in sorted(os.listdir(anomaly_dir)):\n",
    "            if fname.upper().endswith(\".JPG\"):\n",
    "                image_paths.append(os.path.join(anomaly_dir, fname))\n",
    "                labels.append(1)\n",
    "\n",
    "        return image_paths, labels\n",
    "\n",
    "\n",
    "print(f\"PCBDataset sınıfı tanımlandı.\")\n",
    "print(f\"  Normal dizini  → etiket 0\")\n",
    "print(f\"  Anomaly dizini → etiket 1\")"
   ]
