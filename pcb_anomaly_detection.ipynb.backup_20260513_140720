    "cnn_f1      = cnn_metrics['f1_macro']\n",
    "transfer_f1 = transfer_metrics['f1_macro']\n",
    "f1_diff     = abs(cnn_f1 - transfer_f1)\n",
    "\n",
    "print(\"=\"*60)\n",
    "print(\"MODEL ÖNERİSİ\")\n",
    "print(\"=\"*60)\n",
    "print(f\"  CustomCNN     Macro-F1: {cnn_f1:.4f}\")\n",
    "print(f\"  TransferModel Macro-F1: {transfer_f1:.4f}\")\n",
    "print(f\"  F1 farkı              : {f1_diff:.4f}\")\n",
    "\n",
    "if f1_diff >= 0.05:\n",
    "    winner = \"TransferModel\" if transfer_f1 > cnn_f1 else \"CustomCNN\"\n",
    "    print(f\"\\n→ F1 farkı >= 0.05: Daha yüksek F1'li model önerilir: {winner}\")\n",
    "    print(f\"  Gerekçe: {f1_diff:.4f} puanlık anlamlı performans farkı mevcuttur.\")\n",
    "else:\n",
    "    cnn_p_count = cnn_model.count_parameters()['trainable']\n",
    "    trf_p_count = transfer_model.count_parameters()['trainable']\n",
    "    winner = \"CustomCNN\" if cnn_p_count < trf_p_count else \"TransferModel\"\n",
    "    print(f\"\\n→ F1 farkı < 0.05: Daha az parametreli model önerilir: {winner}\")\n",
