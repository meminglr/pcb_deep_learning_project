   "source": [
    "# ── Bölüm 5.1: Evaluator Sınıfı ───────────────────────────────────────────\n",
    "class Evaluator:\n",
    "    \"\"\"\n",
    "    Model değerlendirme sınıfı.\n",
    "    Test seti üzerinde metrik hesaplama ve görselleştirme yapar.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, model: nn.Module, device: torch.device,\n",
    "                 test_loader: DataLoader):\n",
    "        self.model       = model\n",
    "        self.device      = device\n",
    "        self.test_loader = test_loader\n",
    "        self._preds      = None\n",
    "        self._probs      = None\n",
    "        self._labels     = None\n",
    "\n",
    "    def _run_inference(self, model_name: str) -> None:\n",
    "        weight_path = f\"best_{model_name}.pth\"\n",
    "        if not os.path.exists(weight_path):\n",
    "            raise FileNotFoundError(\n",
    "                f\"Model ağırlık dosyası bulunamadı: '{weight_path}'. \"\n",
    "                f\"Lütfen önce modeli eğitin.\"\n",
    "            )\n",
    "        self.model.load_state_dict(torch.load(weight_path, map_location=self.device))\n",
    "        self.model.eval()\n",
    "        all_preds, all_probs, all_labels = [], [], []\n",
    "        with torch.no_grad():\n",
    "            for images, labels in self.test_loader:\n",
    "                images  = images.to(self.device)\n",
    "                outputs = self.model(images)\n",
    "                probs   = torch.softmax(outputs, dim=1)[:, 1].cpu().numpy()\n",
    "                preds   = outputs.argmax(dim=1).cpu().numpy()\n",
    "                all_preds.extend(preds)\n",
    "                all_probs.extend(probs)\n",
    "                all_labels.extend(labels.numpy())\n",
    "        self._preds  = all_preds\n",
    "        self._probs  = all_probs\n",
    "        self._labels = all_labels\n",
    "\n",
    "    def evaluate(self, model_name: str) -> dict:\n",
    "        self._run_inference(model_name)\n",
    "        y_true, y_pred, y_prob = self._labels, self._preds, self._probs\n",
    "        metrics = {\n",
    "            \"accuracy\":           accuracy_score(y_true, y_pred),\n",
    "            \"precision_macro\":    precision_score(y_true, y_pred, average='macro',    zero_division=0),\n",
    "            \"precision_weighted\": precision_score(y_true, y_pred, average='weighted', zero_division=0),\n",
    "            \"recall_macro\":       recall_score(y_true, y_pred, average='macro',    zero_division=0),\n",
    "            \"recall_weighted\":    recall_score(y_true, y_pred, average='weighted', zero_division=0),\n",
    "            \"f1_macro\":           f1_score(y_true, y_pred, average='macro',    zero_division=0),\n",
    "            \"f1_weighted\":        f1_score(y_true, y_pred, average='weighted', zero_division=0),\n",
    "            \"roc_auc\":            roc_auc_score(y_true, y_prob),\n",
    "            \"avg_precision\":      average_precision_score(y_true, y_prob),\n",
    "        }\n",
    "        return metrics\n",
    "\n",
    "    def plot_confusion_matrix(self, model_name: str) -> None:\n",
    "        cm = confusion_matrix(self._labels, self._preds)\n",
    "        fig, ax = plt.subplots(figsize=(6, 5))\n",
    "        sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',\n",
    "                    xticklabels=['Normal', 'Anomaly'],\n",
    "                    yticklabels=['Normal', 'Anomaly'], ax=ax)\n",
    "        ax.set_xlabel('Tahmin Edilen Etiket', fontsize=12)\n",
    "        ax.set_ylabel('Gerçek Etiket', fontsize=12)\n",
    "        ax.set_title(f'Karışıklık Matrisi — {model_name}', fontsize=13, fontweight='bold')\n",
    "        tn, fp, fn, tp = cm.ravel()\n",
    "        print(f\"  TP={tp}, TN={tn}, FP={fp}, FN={fn}\")\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "    def plot_roc_curves(self, evaluators: list, names: list) -> None:\n",
    "        fig, ax = plt.subplots(figsize=(7, 6))\n",
    "        colors = ['steelblue', 'tomato']\n",
    "        for ev, name, color in zip(evaluators, names, colors):\n",
    "            fpr, tpr, _ = roc_curve(ev._labels, ev._probs)\n",
    "            auc_val = roc_auc_score(ev._labels, ev._probs)\n",
    "            ax.plot(fpr, tpr, color=color, linewidth=2, label=f'{name} (AUC={auc_val:.3f})')\n",
    "        ax.plot([0, 1], [0, 1], 'k--', linewidth=1, label='Rastgele Sınıflandırıcı')\n",
    "        ax.set_xlabel('Yanlış Pozitif Oranı (FPR)', fontsize=12)\n",
    "        ax.set_ylabel('Doğru Pozitif Oranı (TPR)', fontsize=12)\n",
    "        ax.set_title('ROC Eğrileri', fontsize=14, fontweight='bold')\n",
    "        ax.legend(fontsize=11)\n",
    "        ax.grid(True, alpha=0.3)\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "    def plot_pr_curves(self, evaluators: list, names: list) -> None:\n",
    "        fig, ax = plt.subplots(figsize=(7, 6))\n",
    "        colors = ['steelblue', 'tomato']\n",
    "        for ev, name, color in zip(evaluators, names, colors):\n",
    "            prec, rec, _ = precision_recall_curve(ev._labels, ev._probs)\n",
    "            ap = average_precision_score(ev._labels, ev._probs)\n",
    "            ax.plot(rec, prec, color=color, linewidth=2, label=f'{name} (AP={ap:.3f})')\n",
    "        ax.set_xlabel('Recall', fontsize=12)\n",
    "        ax.set_ylabel('Precision', fontsize=12)\n",
    "        ax.set_title('Precision-Recall Eğrileri', fontsize=14, fontweight='bold')\n",
    "        ax.legend(fontsize=11)\n",
    "        ax.grid(True, alpha=0.3)\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "    def plot_misclassified(self, model_name: str, n: int = 5) -> None:\n",
    "        test_paths = self.test_loader.dataset.image_paths\n",
    "        y_true, y_pred = self._labels, self._preds\n",
    "        fp_indices = [i for i, (t, p) in enumerate(zip(y_true, y_pred)) if t == 0 and p == 1]\n",
    "        fn_indices = [i for i, (t, p) in enumerate(zip(y_true, y_pred)) if t == 1 and p == 0]\n",
    "        for error_type, indices, true_lbl, pred_lbl in [\n",
    "            ('False Positive (Normal → Anomaly)', fp_indices, 'Normal', 'Anomaly'),\n",
    "            ('False Negative (Anomaly → Normal)', fn_indices, 'Anomaly', 'Normal')\n",
    "        ]:\n",
    "            sample = indices[:n]\n",
    "            if not sample:\n",
    "                print(f\"  {error_type}: Örnek bulunamadı.\")\n",
    "                continue\n",
    "            cols = len(sample)\n",
    "            fig, axes = plt.subplots(1, cols, figsize=(3 * cols, 3))\n",
    "            if cols == 1:\n",
    "                axes = [axes]\n",
    "            fig.suptitle(f'{model_name} — {error_type}', fontsize=12, fontweight='bold')\n",
    "            for ax, idx in zip(axes, sample):\n",
    "                img = Image.open(test_paths[idx]).convert('RGB')\n",
    "                ax.imshow(img)\n",
    "                ax.set_title(f'Gerçek: {true_lbl}\\nTahmin: {pred_lbl}', fontsize=8)\n",
    "                ax.axis('off')\n",
    "            plt.tight_layout()\n",
    "            plt.show()\n",
    "\n",
    "    def plot_training_history(self, history: dict, model_name: str) -> None:\n",
    "        epochs = range(1, len(history['train_loss']) + 1)\n",
    "        fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "        fig.suptitle(f'Eğitim Geçmişi — {model_name}', fontsize=14, fontweight='bold')\n",
    "        axes[0].plot(epochs, history['train_loss'], 'b-', linewidth=2, label='Eğitim Kaybı')\n",
    "        axes[0].plot(epochs, history['val_loss'],   'r-', linewidth=2, label='Doğrulama Kaybı')\n",
    "        overfit_epochs = [\n",
    "            e for e, (ta, va) in enumerate(zip(history['train_acc'], history['val_acc']), 1)\n",
    "            if ta - va > 10.0\n",
    "        ]\n",
    "        for ep in overfit_epochs:\n",
    "            axes[0].axvline(x=ep, color='orange', linestyle='--', alpha=0.5)\n",
    "        axes[0].set_xlabel('Epoch', fontsize=11)\n",
    "        axes[0].set_ylabel('Kayıp', fontsize=11)\n",
    "        axes[0].set_title('Kayıp Eğrisi', fontsize=12)\n",
    "        axes[0].legend(fontsize=10)\n",
    "        axes[0].grid(True, alpha=0.3)\n",
    "        axes[1].plot(epochs, history['train_acc'], 'b-', linewidth=2, label='Eğitim Doğruluğu')\n",
    "        axes[1].plot(epochs, history['val_acc'],   'r-', linewidth=2, label='Doğrulama Doğruluğu')\n",
    "        axes[1].set_xlabel('Epoch', fontsize=11)\n",
    "        axes[1].set_ylabel('Doğruluk (%)', fontsize=11)\n",
    "        axes[1].set_title('Doğruluk Eğrisi', fontsize=12)\n",
    "        axes[1].legend(fontsize=10)\n",
    "        axes[1].grid(True, alpha=0.3)\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "        n_last = min(5, len(history['train_loss']))\n",
    "        gap = (sum(history['train_loss'][-n_last:]) / n_last -\n",
    "               sum(history['val_loss'][-n_last:]) / n_last)\n",
    "        print(f\"Overfitting gap (son {n_last} epoch ortalaması): {gap:.4f}\")\n",
    "        if overfit_epochs:\n",
    "            print(f\"Overfitting eşiği (>10pp) aşılan epoch'lar: {overfit_epochs}\")\n",
    "        else:\n",
    "            print(\"Overfitting eşiği aşılmadı\")\n",
    "\n",
    "\n",
    "print(\"Evaluator sınıfı tanımlandı.\")"
   ]
